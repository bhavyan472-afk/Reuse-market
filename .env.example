# ---------------------------------------------------------------------------
# ReUse Market — environment variables
# Copy to .env.local for local development, and add the same keys in Vercel
# (Project → Settings → Environment Variables).
#
# Only NEXT_PUBLIC_* values are used, and they are all safe to expose to the
# browser: the Supabase anon key is protected by Row Level Security. Maps need no
# API key (see README, section 7).
# NEVER put the Supabase service_role key in this app.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Maps (Leaflet + OpenStreetMap) — no API key needed. All optional.
# Defaults: public OSM tiles (https://tile.openstreetmap.org/{z}/{x}/{y}.png) and the public
# Nominatim geocoder. Both are for light use only (see their usage policies). For production
# traffic, point these at a tile/geocoding provider or plan that permits your usage.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=
NEXT_PUBLIC_GEOCODER_URL=

# Public URL of the site (used for sitemap, canonical URLs and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" after enabling the Google provider in Supabase Auth
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
